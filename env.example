# VaultGate environment configuration.
# Copy this file to `.env` for local runs:  cp env.example .env

# The CTF flag. Read server-side only; never baked into client assets.
CTF_FLAG=CTF{vaultgate_three_paths_one_flag}

# HTTP port the web application binds (0.0.0.0:PORT). Railway sets this for you.
PORT=3000

# Internal loopback-only diagnostics service port (Path 1 target).
INTERNAL_DIAG_PORT=8080

# Where the on-disk flag copy is written (post-exploitation read location).
FLAG_DIR=/opt/vaultgate/secrets

# Administrator password (intentionally weak; must exist in ctf-wordlist.txt).
# Leave unset to use the default 'winter2024'.
# ADMIN_PASSWORD=winter2024

# Express session secret.
SESSION_SECRET=change-me-in-production

# Optional real SSH inside the container (local Docker only). Railway: keep false.
ENABLE_SSH=false

NODE_ENV=production
