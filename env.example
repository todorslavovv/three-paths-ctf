# VaultGate environment configuration.
# Copy this file to `.env` for local runs:  cp env.example .env

# The CTF flag. Read server-side only; never baked into client assets.
CTF_FLAG=CTF{vaultgate_three_paths_one_flag}

# HTTP port the web application binds (0.0.0.0:PORT). Railway sets this for you.
PORT=3000

# Internal loopback-only diagnostics service port (Path 1 target).
INTERNAL_DIAG_PORT=8080

# Where the on-disk flag copy is written (post-exploitation read location).
FLAG_DIR=/opt/vaultgate/secrets

# Administrator password (intentionally weak; must exist in ctf-wordlist.txt).
# Leave unset to use the default 'winter2024'.
# ADMIN_PASSWORD=winter2024

# Express session secret.
SESSION_SECRET=change-me-in-production

# Optional real SSH inside the container (local Docker only). Railway: keep false.
ENABLE_SSH=false

# --- VaultBot (Path 3) real-LLM backend, via OpenCode Zen (optional) ---
# Get a free key at https://opencode.ai/auth . When unset, VaultBot uses the
# built-in deterministic engine (fully offline). When set, it calls a small free
# model; the flag lives only in the server-side system prompt (never in the repo).
# OPENCODE_API_KEY=sk-...
# Default model laguna-s-2.1-free: fast, non-reasoning, cheap. Avoid the free
# reasoning models (nemotron-*, hy3-free) here — they spend the whole budget on
# hidden "thinking" and return empty content. Other free ids: mimo-v2.5-free,
# muse-spark-1.2-contributor-free (availability/rate-limits vary).
# VAULTBOT_MODEL=laguna-s-2.1-free
# VAULTBOT_MAX_TOKENS=160
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

NODE_ENV=production
